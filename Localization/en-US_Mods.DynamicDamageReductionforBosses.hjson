Configs: {
	DDRConfigVanilla: {
		DisplayName: ① Vanilla Bosses

		Headers: {
			General: General
			PreHardmode: Pre-Hardmode
			Hardmode: Hardmode
		}

		EnableDamageReduction: {
			Label: Enable Damage Reduction
			Tooltip: When enabled, selected bosses cannot be killed before the minimum kill time
		}

		MinKillSeconds: {
			Label: Minimum Kill Time (s)
			Tooltip: How many seconds the boss must survive before it can be killed
		}

		Sensitivity: {
			Label: Reduction Strength
			Tooltip: Higher = sharper damage reduction when your DPS is too high; lower = more gradual
		}

		MinDamageRatio: {
			Label: Minimum Damage Ratio
			Tooltip: Even with full reduction, each hit will always deal at least this fraction of base damage. 0.05 = minimum 5%, so the boss never becomes completely immune
		}

		PhaseRatio: {
			Label: Limb Phase Ratio
			Tooltip: Only affects multi-part bosses (e.g. Moon Lord, Golem). Sets what fraction of the kill timer is reserved for killing limbs/appendages before the main body. 0.5 = equal split. Ignored for single-part bosses
		}

		EnableHpMultiplier: {
			Label: Enable HP Multiplier
			Tooltip: When enabled, selected bosses spawn with their HP multiplied. If you're seeing lots of 1s, try turning this on
		}

		HpMultiplier: {
			Label: HP Multiplier
			Tooltip: 1 = vanilla HP, 10 = ten times HP, max 10000
		}

