Configs: {
	DDRConfig: {
		DisplayName: 原版Boss

		Headers: {
			General: 基本设置
			PreHardmode: 困难模式前
			Hardmode: 困难模式
		}

		EnableDamageReduction: {
			Label: 启用动态减伤
			Tooltip: 开启后，选中的 Boss 不会早于"最短击杀时间"死亡
		}

		MinKillSeconds: {
			Label: 最短击杀时间（秒）
			Tooltip: Boss 至少要撑多少秒才能被打死
		}

		Sensitivity: {
			Label: 减伤强度
			Tooltip: 值越大，输出越高时减伤越猛烈；值越小，减伤越平缓
		}

		MinDamageRatio: {
			Label: 最低伤害比例
			Tooltip: 减伤再强，每次攻击也至少打出原始伤害的这个比例。0.05 = 最低 5%，防止完全打不动
		}

		PhaseRatio: {
			Label: 附属部位时间占比
			Tooltip: 仅对多段式 Boss 生效（如月亮领主、石巨人）。前半段时间用于击杀手/臂等附属部位，后半段用于击杀本体。0.5 = 各占一半
		}

		EnableHpMultiplier: {
			Label: 启用血量倍数
			Tooltip: 开启后，选中的 Boss 生成时血量乘以指定倍数
		}

		HpMultiplier: {
			Label: 血量倍数
			Tooltip: 1 = 原版血量，10 = 十倍血量，上限 10000
		}

